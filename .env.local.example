# Convex — populated automatically by `npx convex dev` on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk — from your Clerk application's API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Clerk JWT issuer domain, set as a Convex deployment env var (not here) via:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN <value>
# Used by convex/auth.config.ts. Find it under Clerk Dashboard > JWT Templates > Convex.

# --- Not yet wired: clarification/breakdown LLM calls are stubbed in
# lib/llm/clarify.ts and lib/llm/breakdown.ts. When ready to call real
# Vertex AI, set these as Convex deployment env vars (via `npx convex env
# set`, NOT here — Convex actions run in Convex's own Node runtime, not
# Next.js), mirroring Cato MVP 2:
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY=
